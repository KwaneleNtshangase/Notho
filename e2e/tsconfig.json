{
  "compilerOptions": {
    "target": "ES2017",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    // DOM is required, not optional: page.evaluate() and page.addInitScript()
    // take callbacks that run *in the browser*, so they legitimately reference
    // document, localStorage and getComputedStyle. Without it those specs threw
    // "Cannot find name 'document'" and the e2e types never actually checked.
    "lib": ["ES2017", "DOM"]
  },
  "include": ["./**/*.ts"]
}
