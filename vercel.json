{
  "crons": [
    { "path": "/api/cron/lifecycle", "schedule": "30 7 * * *" },
    { "path": "/api/cron/push-triggers", "schedule": "15 * * * *" }
  ],
  "redirects": [
    {
      "source": "/:path(.*)",
      "has": [{ "type": "host", "value": "fundiapp.co.za" }],
      "destination": "https://www.notho.co.za/:path",
      "permanent": true
    },
    {
      "source": "/:path(.*)",
      "has": [{ "type": "host", "value": "www.fundiapp.co.za" }],
      "destination": "https://www.notho.co.za/:path",
      "permanent": true
    }
  ]
}
